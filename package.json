{
  "name": "animate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm -F examples dev",
    "build": "pnpm -F @drawcall/animate build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:seeds": "for offset in 0 1 2 3; do LIFE_SEED_OFFSET=$offset pnpm -r test || exit $?; done",
    "metrics": "pnpm -F examples metrics",
    "bench": "pnpm -F examples bench",
    "bench:browser": "node examples/scripts/bench.mjs",
    "capture": "node examples/scripts/capture.mjs",
    "video": "node examples/scripts/video.mjs",
    "run-scene": "pnpm -F examples run-scene",
    "check": "pnpm typecheck && pnpm test && pnpm metrics && pnpm -F examples build && pnpm -F @drawcall/animate exec npm pack --dry-run"
  },
  "devDependencies": {
    "npm": "11.6.4",
    "playwright": "^1.55.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.0"
  }
}
