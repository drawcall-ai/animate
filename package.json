{
  "name": "animate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm -F viewer dev",
    "dev:shooter": "pnpm -F shooter dev",
    "dev:throne-room": "pnpm -F throne-room dev",
    "build": "pnpm -F @drawcall/animate build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:seeds": "for offset in 0 1 2 3; do LIFE_SEED_OFFSET=$offset pnpm test || exit $?; done",
    "metrics": "pnpm -F viewer metrics",
    "bench": "pnpm -F viewer bench",
    "capture": "node examples/viewer/scripts/capture.mjs",
    "video": "node examples/viewer/scripts/video.mjs",
    "run-scene": "pnpm -F viewer run-scene",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm -F viewer build && pnpm -F shooter build && pnpm -F @drawcall/animate exec npm pack --dry-run",
    "viewer:check": "pnpm exec node examples/viewer/scripts/viewer-check.mjs"
  },
  "devDependencies": {
    "npm": "11.6.4",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  }
}
