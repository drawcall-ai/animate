{
  "name": "@prohuman/core",
  "version": "0.1.0",
  "description": "Procedural humanlike full-body motion for three.js from sparse targets (head, hands, feet, chest, hips, a goal, a seat).",
  "keywords": [
    "three",
    "threejs",
    "ik",
    "inverse-kinematics",
    "full-body-ik",
    "procedural-animation",
    "humanoid",
    "vrm",
    "locomotion",
    "webxr",
    "viverse"
  ],
  "homepage": "https://prohuman.pages.dev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@prohuman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint:pkg": "publint --strict && attw --pack --profile esm-only"
  },
  "peerDependencies": {
    "@pmndrs/viverse": ">=0.2.29",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@pmndrs/viverse": "^0.2.29",
    "@types/three": "^0.180.0",
    "three": "^0.180.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
