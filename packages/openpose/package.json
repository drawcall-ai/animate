{
  "name": "@prohuman/openpose",
  "version": "0.1.0",
  "description": "OpenPose-style (BODY_25) skeletons for three.js: a @pmndrs/viverse character model drawn as OpenPose, driven by @prohuman/core.",
  "keywords": [
    "three",
    "threejs",
    "openpose",
    "body25",
    "controlnet",
    "skeleton",
    "pose"
  ],
  "homepage": "https://prohuman.pages.dev",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@prohuman/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "lint:pkg": "publint --strict && attw --pack --profile esm-only"
  },
  "dependencies": {
    "@prohuman/core": "workspace:^"
  },
  "peerDependencies": {
    "@pmndrs/viverse": ">=0.2.29",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@pmndrs/viverse": "^0.2.29",
    "@types/three": "^0.180.0",
    "three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
