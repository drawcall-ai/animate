{
  "name": "@drawcall/animate",
  "version": "0.0.0",
  "description": "Procedural, lifelike motion for three.js characters and creatures rigged with @drawcall/rig: bodies that walk, look, reach, grab and carry as your stories ask.",
  "keywords": ["three", "threejs", "procedural-animation", "inverse-kinematics", "humanoid", "creature", "locomotion", "timeline", "rig"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./species": { "source": "./src/species.ts", "types": "./dist/species.d.ts", "default": "./dist/species.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "skills"],
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@drawcall/rig": "^0.5.0" },
  "peerDependencies": { "@pmndrs/timeline": "^0.4.0", "three": ">=0.170.0" },
  "devDependencies": { "@pmndrs/timeline": "^0.4.0", "@types/three": "^0.180.0", "three": "^0.180.0", "typescript": "^5.9.0", "vite": "^7.3.6", "vitest": "^3.2.0" }
}
