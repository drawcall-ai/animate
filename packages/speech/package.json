{
  "name": "@drawcall/speech",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A recorded line as a face says it: its words and ARPAbet phones timed, its loudness and pitch, and forced alignment of a recording to its text.",
  "exports": "./src/index.ts",
  "imports": {
    "#align": {
      "node": "./src/align/node.ts",
      "default": "./src/align/browser.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --silent=false"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "^3.0.0"
  },
  "devDependencies": {
    "@audio/decode": "^3.16.2",
    "@audio/resample-sinc": "^1.4.0",
    "@drawcall/cache": "^0.9.1",
    "@huggingface/transformers": "^3.8.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
